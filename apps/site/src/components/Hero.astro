---
import Media from './Media.astro';
import AppLink from './AppLink.astro';
import DownloadLink from './DownloadLink.astro';
import { docHref } from '../lib/docs';
import { version } from '../../package.json';

const about = 'The editor at work: a film directed in words, and every layer of it in the atelier.';
const minor = version.split('.').slice(0, 2).join('.');
---

<section class="hero">
  <div class="wrap top">
    <div class="lead">
      <a class="news" href="#studio"><i aria-hidden="true"></i>New in {minor}: the studio</a>
      <h1><span>Motion design,</span> <span class="quiet">directed in words.</span></h1>
    </div>
    <div class="side">
      <p>An open-source engine and editor. Leave notes on the film, keep the takes you like, open the atelier for the detail: you and the AI edit the same JSON document, with the same undo.</p>
      <div class="ctas">
        <AppLink />
        <DownloadLink />
        <a class="btn btn-ghost" href={docHref('')}>Read the docs</a>
      </div>
    </div>
  </div>

  <div class="wrap-wide stage">
    <Media id="tramme" width={1920} height={1080} duration={10} tint={['#0b0f12', '#2ec4b6']} label={`tramme. ${about}`} />
    <p class="caption"><strong>tramme.</strong> {about}</p>
  </div>
</section>

<style>
  .hero { padding-top: clamp(48px, 8vw, 104px); }
  .top { display: grid; grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); gap: 32px 64px; align-items: end; }
  h1 { font-size: clamp(2.75rem, 5.4vw, 5rem); line-height: 0.98; letter-spacing: -0.048em; }
  h1 span { display: block; }
  .lead { display: grid; gap: 24px; justify-items: start; }
  .news {
    display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 14px 0 10px; border-radius: 999px;
    background: var(--panel); box-shadow: inset 0 0 0 1px var(--line); color: var(--ink-2); font-size: 0.8125rem; text-decoration: none;
    transition: color 0.2s var(--ease);
  }
  .news:hover { color: var(--ink); }
  .news i { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .quiet { color: var(--ink-3); }
  .side { display: grid; gap: 28px; max-width: 30rem; padding-bottom: 0.35rem; }
  .side p { font-size: 1.125rem; line-height: 1.55; color: var(--ink-2); }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }

  .stage { position: relative; margin-top: clamp(48px, 6.5vw, 88px); }
  .stage :global(.media) { box-shadow: var(--lift); border-radius: var(--r-lg); }
  .caption { margin-top: 16px; }

  @media (prefers-reduced-motion: no-preference) {
    .news, h1 span, .side, .stage { animation: enter 0.9s var(--ease) both; }
    h1 span + span { animation-delay: 70ms; }
    .side { animation-delay: 150ms; }
    .stage { animation-delay: 240ms; }
  }
  @keyframes enter { from { opacity: 0; transform: translateY(20px); } }

  @media (max-width: 900px) { .top { grid-template-columns: minmax(0, 1fr); } }
</style>
