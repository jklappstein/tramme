---
// The studio, the app's first view: the film in front, directed by notes.
import PushPin from '@phosphor-icons/core/assets/regular/push-pin.svg';
import FilmSlate from '@phosphor-icons/core/assets/regular/film-slate.svg';
import Compass from '@phosphor-icons/core/assets/regular/compass.svg';
import Head from './Head.astro';
import Shot from './Shot.astro';
import Cards from './Cards.astro';
import light from '../assets/studio-light.png';
import dark from '../assets/studio-dark.png';

const ITEMS = [
  { Icon: PushPin, title: 'Notes, pinned', text: 'Say what should change, as you would to an editor. Pin a note to a moment or a place of the frame, or to a scene of the storyboard.' },
  { Icon: FilmSlate, title: 'Takes, not surprises', text: 'tramme answers with a take shown on the picture. Keep it, or set it aside: nothing lands in the film without you.' },
  { Icon: Compass, title: 'A direction it follows', text: 'The brief (subject, tone, rules), the palette and the material of the film, read before anything is staged.' },
];
const alt = 'The tramme studio: the Showreel example in front, its storyboard below, and the Direction panel with the brief, the palette and the material.';
---

<section class="section" id="studio">
  <div class="wrap">
    <Head title="Direct the film in words." more="The studio puts the film in front: you leave notes, tramme answers with takes." />
  </div>
  <div class="wrap-wide body">
    <Shot light={light} dark={dark} alt={alt} />
    <Cards items={ITEMS} />
  </div>
</section>

<style>
  .body { margin-top: clamp(40px, 5vw, 64px); }
</style>
