---
// A picture of the app in the page's theme: its paper theme on the light
// page, its studio theme on the dark one. Both are lazy, so only the one
// shown loads.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { light: ImageMetadata; dark: ImageMetadata; alt: string }
const { light, dark, alt } = Astro.props;
const SHOTS = [['light', light], ['dark', dark]] as const;
---

<div class="shot" data-reveal>
  {SHOTS.map(([theme, src]) => (
    <Image class={theme} src={src} alt={alt} widths={[800, 1280, 1760, 2560]} sizes="(max-width: 1440px) 100vw, 1440px" loading="lazy" decoding="async" />
  ))}
</div>

<style>
  .shot { border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--lift); background: var(--panel); }
  .shot :global(img) { width: 100%; height: auto; }
  .shot :global(.dark), :global([data-theme='dark']) .shot :global(.light) { display: none; }
  :global([data-theme='dark']) .shot :global(.dark) { display: block; }
</style>
