---
import Scissors from '@phosphor-icons/core/assets/regular/scissors.svg';
import Waveform from '@phosphor-icons/core/assets/regular/waveform.svg';
import PuzzlePiece from '@phosphor-icons/core/assets/regular/puzzle-piece.svg';
import HandPalm from '@phosphor-icons/core/assets/regular/hand-palm.svg';
import Head from './Head.astro';
import Media from './Media.astro';
import Cards from './Cards.astro';

const ITEMS = [
  { Icon: Scissors, title: 'Dresses a video', text: "Once you transcribe it: cuts the silences, then adds captions, keywords and titles in the project's colours." },
  { Icon: Waveform, title: 'Sound on the cut', text: 'Places sounds on the cuts and the entrances, from the library or written as code.' },
  { Icon: PuzzlePiece, title: 'New vocabulary', text: 'Writes a node as a plugin when the built-in ones fall short.' },
  { Icon: HandPalm, title: 'Asks first', text: 'A transcription or a paid generation waits for your yes. Claude with your Claude Code login, or other models with your keys.' },
];
---

<section class="section" id="assistant">
  <div class="wrap">
    <Head title="The AI edits with your tools." more="It reads the document, checks its work on rendered frames, then proposes changes you keep or set aside." />
    <div class="grid">
      <div class="frame" data-reveal>
        <Media id="assistant" width={1600} height={1000} tint={['#090f13', '#2ec4b6']} label="The assistant proposing a change in the tramme editor, previewed before it is applied." />
      </div>
      <Cards items={ITEMS} columns={2} />
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 6fr); gap: var(--gap); align-items: stretch; margin-top: clamp(40px, 5vw, 64px); }
  .grid :global(.cards) { margin: 0; }
  .frame { display: grid; align-items: center; padding: clamp(12px, 1.6vw, 20px); border-radius: var(--r-lg); background: var(--stage); }
  @media (max-width: 1100px) { .grid { grid-template-columns: minmax(0, 1fr); } }
</style>
